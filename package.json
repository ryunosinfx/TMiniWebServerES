{
	"name": "tminiwebserveres",
	"version": "1.0.0",
	"description": "Raspberry Pi Pico W用に作成したコンパクトなWebServerです。\r MicroPythonの環境で動作して、asyncio (uasyncio)を利用して実装しています。",
	"keywords": [
		"websocket"
	],
	"homepage": "https://github.com/ryunosinfx/TMiniWebServerES#readme",
	"bugs": {
		"url": "https://github.com/ryunosinfx/TMiniWebServerES/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ryunosinfx/TMiniWebServerES.git"
	},
	"license": "MIT",
	"author": "",
	"type": "module",
	"main": "index.js",
	"scripts": {
		"test": "echo \"Error: no test specified\" && exit 1",
		"server": "cd ./TMiniWebServerES;node ./SampleServer.js start",
		"serverSample": "cd ./TMiniWebServerES;node ../bundleSample.cjs start",
		"wwwload": "for f in `ls ./wwwroot/*`; do kaluma put ${f} /${f};done",
		"wwwloade": "for f in `ls ./wwwroot/*`; do echo ${f};done",
		"wwwloadi": "kaluma put ./wwwroot/index.html /index.html",
		"wwwloadv": "kaluma put ./wwwroot/Vw.js /Vw.js",
		"flashTest": "kaluma flash index.js",
		"flashWifi": "kaluma flash wifiTest.js",
		"flash": "kaluma flash bundle.js",
		"build": "rollup ./TMiniWebServerES/main.js --file bundle.js -f cjs",
		"buildSample": "rollup ./TMiniWebServerES/SampleServer.js --file bundleSample.cjs -f cjs",
		"build_flash": "rollup ./TMiniWebServerES/main.js --file bundle.js -f cjs;kaluma flash bundle.js"
	},
	"devDependencies": {
		"@kaluma/cli": "^1.4.0",
		"eslint": "^9.38.0",
		"eslint-plugin-jsdoc": "^61.1.7",
		"rollup": "^4.53.2"
	}
}
